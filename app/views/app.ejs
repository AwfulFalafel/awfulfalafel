<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%-
			[
			title, "Awful Falafel"
			].filter(Boolean).join(" | ")
			%></title>
	<link rel=" stylesheet" href="/assets/css/site.css">
</head>

<body class="bg-midnight text-lime-50 p-5 sm:p-4 overflow-y-scroll text-lg sm:text-base">
	<header class="mx-auto my-5 text-center">
		<h1 class="text-3xl sm:text-4xl font-bold font-af">
			Awful Falafel
		</h1>
	</header>
	<nav class="mx-auto my-5 text-center">
		<ul>
			<% Object.entries(site).forEach(([key, { label, url }]) => { %>
				<li class="inline not-first:before:content-['|'] not-first:before:mx-1">
					<a class="px-1" href="<%- url %>"><%- label %></a>
				</li>
			<% }) %>
		</ul>
	</nav>
	<main class="mx-auto my-5">
		<%- include(`pages/page`, { page, title }) %>
	</main>
	<footer class="mx-auto my-5 text-center">
		Copyright &copy;<%- new Date().getFullYear() %> Awful Falafel.
	</footer>
</body>

</html>