<% content_for(:title, "Songs") %>
<p class="mb-2">
	We perform a variety of music from the 70's to now (<%= @songs.size %> songs and counting!). This is our current catalog, and we are always adding new music!
</p>
<div>
	<ul class="list-disc list-inside">
		<% @songs.each do |song| %>
			<li><%= song.full_title() %></li>
		<% end %>
	</ul>
</div>