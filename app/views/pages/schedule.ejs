<div id="upcoming">
	<article class="mb-5">
		<h3 class="mb-2 text-xl font-bold">Upcoming</h3>
		<p class="mb-2" v-if="upcoming.length === 0">We currently have no shows booked. Check back later!</p>
		<% shows.upcoming.forEach((show) => { %>
			<%- include("_show", { show }) %>
		<% }); %>
	</article>
</div>
<div id="past">
	<article class="mb-5">
		<h3 class="mb-2 text-xl font-bold">Past</h3>
		<% shows.past.forEach((show) => { %>
			<%- include("_show", { show }) %>
		<% }); %>
	</article>
</div>
