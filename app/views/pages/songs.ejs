<p class="mb-2">
	We perform a variety of music from the 70's to now (<%- catalog.length %> songs and counting!). This is our current catalog, and we are always adding new music!
</p>
<div>
	<ul class="list-disc list-inside">
		<% catalog.forEach(({ artist, title }) => { %>
			<li><%- artist %> - <%- title %></li>
		<% }) %>
	</ul>
</div>