@page
@model ScheduleModel

<div id="upcoming">
	<article class="mb-5">
		<h3 class="mb-2 text-xl font-bold">Upcoming</h3>
		@if (Model.UpcomingShows.Count == 0) {
			<p class="mb-2">We currently have no shows booked. Check back later!</p>
		}
		else {
		@foreach (var show in Model.UpcomingShows) {
			<partial name="_Show" model="@show"></partial>
		}
		}
	</article>
</div>
<div id="past">
	<article class="mb-5">
		<h3 class="mb-2 text-xl font-bold">Past</h3>
		@foreach (var show in Model.PastShows) {
			<partial name="_Show" model="@show"></partial>
		}
	</article>
</div>
