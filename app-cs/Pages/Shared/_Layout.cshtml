@{
	List<Nav>? site = ViewData["Site"] as List<Nav>;
	Nav pageNav;
	string pageTitle = "";
	if (site != null) {
		string possibleUrl = (Context.GetRouteValue("page") as string).Replace("/", "").ToLower();
		pageNav = site.Find((nav) => nav.Url == possibleUrl);
		if (pageNav != null) {
			pageTitle = pageNav.Title;
		}
	}
}
<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
		@if (!String.IsNullOrEmpty(pageTitle)) {
			<title>@pageTitle | Awful Falafel</title>
		}
		else {
			<title>Awful Falafel</title>
		}
	<link rel=" stylesheet" href="~/css/site.css">
</head>

<body class="bg-midnight text-lime-50 p-5 sm:p-4 overflow-y-scroll text-lg sm:text-base">
	<header class="mx-auto my-5 text-center">
		<h1 class="text-3xl sm:text-4xl font-bold font-af">
			Awful Falafel
		</h1>
	</header>
	<partial name="_Nav" view-data="ViewData"></partial>
	<main class="mx-auto my-5">
		@if (!String.IsNullOrEmpty(pageTitle)) {
			<h2 class="text-2xl text-center mb-3 mx-4">@pageTitle</h2>
		}

		<div class="m-auto lg:w-1/2">
			@RenderBody()
		</div>
	</main>
	<footer class="mx-auto my-5 text-center">
		Copyright &copy; @DateTime.Now.Year Awful Falafel.
	</footer>
</body>

</html>