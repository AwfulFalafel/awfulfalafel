<nav class="mx-auto my-5 text-center">
		<ul>
			@using AwfulFalafel.Pages;
			@{var site = ViewData["site"] as List<Nav>;}
			@if (site is not null) {
				@foreach (var entry in site) {
					<li class="inline not-first:before:content-['|'] not-first:before:mx-1">
						<a class="px-1" asp-page="@entry.Url">@entry.Label</a>
					</li>
				}
			}
		</ul>
	</nav>