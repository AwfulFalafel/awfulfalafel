@page "{id}";
@using AwfulFalafelCommon;
@model ShowEditModel;
@{
	ViewData["Title"] = "Edit show";
}
<div>
	@if (Model.Show != null)
	{
		<form method="post">
			<div class="mb-4 grid grid-cols-4">
				<label class="col-span-1 p-2" asp-for="Name">Name</label>
				<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Name" value="@Model.Show.Name">
			</div>
			<div class="mb-4 grid grid-cols-4">
				<label class="col-span-1 p-2" asp-for="EventLink">Event Link</label>
				<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="EventLink" value="@Model.Show.EventLink">
			</div>
			<div class="mb-4 grid grid-cols-4">
				<label class="col-span-1 p-2" asp-for="Location">Location</label>
				<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Location" value="@Model.Show.Location">
			</div>
			<div class="mb-4 grid grid-cols-4">
				<label class="col-span-1 p-2" asp-for="Venue">Venue</label>
				<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Venue" value="@Model.Show.Venue">
			</div>
			<div class="mb-4 grid grid-cols-4">
				<label class="col-span-1 p-2" asp-for="Date">Date</label>
				<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Date" value="@Model.Show.Date.ToString("yyyy-MM-ddTHH:mm")" />
			</div>
			<input class="p-2 rounded-lg bg-green-500" type="submit" value="Submit">
		</form>

		<div class="mt-4">
			<form asp-page-handler="Delete" asp-page="/Schedule/Index" method="post" asp-route-id="@Model.Show.Id">
				<input type="submit" class="p-2 rounded-lg bg-red-500" value="Delete">
			</form>
		</div>
	}
	else
	{
		<p>Show not found</p>
	}
</div>
