@page "{id}";
@using AwfulFalafelCommon;
@model SongsEditModel;
@{
	ViewData["Title"] = "Edit song";
}

@if (Model.Song != null)
{
	<form method="post">
		<div class="mb-4 grid grid-cols-4">
			<label class="col-span-1 p-2" asp-for="Artist">Artist</label>
			<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Artist" value="@Model.Song.Artist">
		</div>
		<div class="mb-4 grid grid-cols-4">
			<label class="col-span-1 p-2" asp-for="Title">Title</label>
			<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Title" value="@Model.Song.Title">
		</div>
		<input class="p-2 rounded-lg bg-green-500" type="submit" value="Submit">
	</form>

	<div class="mt-4">
		<form asp-page-handler="Delete" asp-page="/Songs/Index" method="post" asp-route-id="@Model.Song.Id">
			<input type="submit" class="p-2 rounded-lg bg-red-500" value="Delete">
		</form>
	</div>
}
else
{
	<p>Song not found</p>
}
