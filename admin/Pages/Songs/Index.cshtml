@page
@using AwfulFalafelCommon;
@model SongsIndexModel;
@{
	ViewData["Title"] = "Songs";
}
<div class="mb-4">
	<h2 class="mb-4 text-xl text-center">Add song</h3>
	<form method="post">
		<div class="mb-4 grid grid-cols-4">
			<label class="col-span-1 p-2" asp-for="Artist">Artist</label>
			<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Artist">
		</div>
		<div class="mb-4 grid grid-cols-4">
			<label class="col-span-1 p-2" asp-for="Title">Title</label>
			<input class="col-span-3 bg-gray-500 p-2 rounded-sm" asp-for="Title">
		</div>
		<div class="text-center">
			<input class="p-2 w-full rounded-lg bg-green-500" type="submit" value="Submit">
		</div>
	</form>
</div>

<div>
	<h2 class="mb-4 text-xl text-center">All songs</h3>
	<table class="mx-auto border-collapse">
		<thead>
			<tr>
				<th class="p-2">Artist</th>
				<th class="p-2">Title</th>
				<th class="p-2">Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Song song in Model.Songs)
			{
				<tr>
					<td class="p-2 border-b-1 border-b-gray-700">@song.Artist</td>
					<td class="p-2 border-b-1 border-b-gray-700">@song.Title</td>
					<td class="p-2 border-b-1 border-b-gray-700 text-center">
						<a class="inline-block p-2 w-25 text-center rounded-lg bg-blue-500" asp-page="./Edit" asp-route-id="@song.Id">Edit</a>
						<form class="inline-block" asp-page-handler="Delete" method="post" asp-route-id="@song.Id">
							<input type="submit" class="inline-block p-2 w-25 rounded-lg bg-red-500" value="Delete">
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
